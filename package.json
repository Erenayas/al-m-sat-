{
  "name": "alim-satim-panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file=.env.local src/ingest/seed.ts",
    "ingest": "tsx --env-file=.env.local src/ingest/run.ts",
    "test": "tsx --test src/domain/normalize.test.ts src/domain/pricing.test.ts src/domain/profit.test.ts src/ingest/adapters/galleryXml.test.ts src/ingest/fetchFeed.test.ts src/lib/listings.test.ts src/lib/password.test.ts src/lib/search.test.ts",
    "tenant": "tsx --conditions=react-server --env-file=.env.local src/scripts/tenant.ts",
    "logos": "tsx src/scripts/logos.ts",
    "logos:add": "tsx --conditions=react-server src/scripts/logo-add.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "simple-icons": "^16.27.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
